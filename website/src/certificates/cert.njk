---
# One share page per attendee.
#
# permalink ends in `.html` ON PURPOSE, and is NOT the usual `/c/<CODE>/index.html`.
# Both hosts we serve from resolve `/c/<CODE>` to this exact file with ZERO
# redirects: Firebase Hosting has `cleanUrls` on (it strips `.html`), and
# Cloudflare Pages serves `/c/<CODE>.html` at `/c/<CODE>` natively. A directory
# permalink would instead make `/c/<CODE>` a 301 to `/c/<CODE>/` on Firebase,
# and every LinkedIn / WhatsApp / X scraper that refuses to follow redirects
# would drop the Open Graph card. The canonical + og:url below therefore point
# at the extension-less public URL, not at page.url.
pagination:
  data: certificates.items
  size: 1
  alias: cert
permalink: "/c/{{ cert.code }}.html"
# Personal artefacts: shareable by their owner, never a search result.
# (`noindex` covers the page; the PNGs are covered by the X-Robots-Tag on /c/**
# in firebase.json + src/_headers, since a header is the only way to noindex an
# image.)
noindex: true
# The <title> of this page is the attendee's real name. GA4 forbids PII and we
# do not put a named person into a third-party analytics store either way, so
# both SDKs get a sanitized title and a sanitized URL instead of the real ones
# (see the analytics block in _includes/base.njk). The query string still
# travels, so the UTMs on a shared link keep attributing.
analyticsTitle: "Houston certificate"
analyticsPath: "/c/"
eleventyExcludeFromCollections: true
eleventyComputed:
  lang: "{{ cert.lang }}"
---
{% extends "subpage.njk" %}

{% set c = certCopy[cert.lang] or certCopy.en %}
{% set credentialName = cert.certName or cert.eventTitle %}
{% set headline = c.ogTitle | replace('{name}', cert.displayName) | replace('{event}', cert.eventTitle) %}
{# Every date-bearing string has a dateless twin: `eventDate` is remote data and
   the loader blanks anything that is not a plain YYYY-MM-DD rather than letting
   half a date through. #}
{% set summary = (c.ogDescription | replace('{event}', cert.eventTitle) | replace('{date}', cert.eventDateDisplay)) if cert.eventDateDisplay else (c.ogDescriptionNoDate | replace('{event}', cert.eventTitle)) %}
{% set imageAlt = c.imageAlt | replace('{name}', cert.displayName) | replace('{event}', cert.eventTitle) %}
{% set shareText = c.shareText | replace('{event}', cert.eventTitle) %}
{% set eventMeta = cert.eventDateDisplay %}
{% if cert.location %}{% set eventMeta = (eventMeta + " · " + cert.location) if eventMeta else cert.location %}{% endif %}

{# Share links carry UTMs per growth/utm-conventions.md (locked vocabulary:
   snake_case, campaign carries the year, medium from the coarse bucket list).
   `social` = a public post on a platform; `share` + `direct_share` = one person
   handing the link to another, with utm_content naming the surface. The
   LinkedIn add-to-profile certUrl below stays CLEAN: it is stored on the
   profile forever as the credential's URL, not as a campaign click. #}
{% set utmLinkedIn = cert.pageUrl + "?utm_source=linkedin&utm_medium=social&utm_campaign=cert_share_2026" %}
{% set utmX = cert.pageUrl + "?utm_source=twitter&utm_medium=social&utm_campaign=cert_share_2026" %}
{% set utmWhatsApp = cert.pageUrl + "?utm_source=direct_share&utm_medium=share&utm_campaign=cert_share_2026&utm_content=whatsapp" %}
{% set utmCopy = cert.pageUrl + "?utm_source=direct_share&utm_medium=share&utm_campaign=cert_share_2026&utm_content=copy_link" %}

{# LinkedIn "Add to profile": organizationId is the precise form (it binds the
   credential to Houston's real company page). organizationName is the fallback
   for as long as an event has no org id on record. #}
{% set liOrg = "organizationId=" + cert.linkedinOrgId if cert.linkedinOrgId else "organizationName=Houston" %}
{# issueYear/issueMonth are precomputed in lib/certs/fetch.mjs and are null when
   the event carries no usable date. LinkedIn accepts the form without them, so
   the credential still adds — it just carries no issue date. #}
{% set liIssued = ("&issueYear=" + cert.issueYear + "&issueMonth=" + cert.issueMonth) if cert.issueYear else "" %}
{% set liAdd = "https://www.linkedin.com/profile/add?startTask=CERTIFICATION_NAME&name=" + (credentialName | urlencode) + "&" + liOrg + liIssued + "&certUrl=" + (cert.pageUrl | urlencode) + "&certId=" + (cert.code | urlencode) %}

{% block title %}{{ headline }} · Houston{% endblock %}

{# This page owns a unique social card (the attendee's own 1200x630 image), so
   it replaces base.njk's default set entirely instead of adding a second one. #}
{% block socialImage %}<meta property="og:image" content="{{ cert.ogImageUrl }}">
<meta property="og:image:secure_url" content="{{ cert.ogImageUrl }}">
<meta property="og:image:type" content="image/png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ imageAlt }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="{{ cert.ogImageUrl }}">
<meta name="twitter:image:alt" content="{{ imageAlt }}">{% endblock %}

{% block canonical %}<link rel="canonical" href="{{ cert.pageUrl }}">{% endblock %}

{% block meta %}
{# `dump` quotes and escapes; the extra replace neutralises a literal "<" so a
   name or title can never close the script element. #}
{% macro json(value) %}{{ value | dump | replace("<", "\\u003c") | safe }}{% endmacro %}
<meta name="description" content="{{ summary }}">
<meta property="og:type" content="article">
<meta property="og:url" content="{{ cert.pageUrl }}">
<meta property="og:title" content="{{ headline }}">
<meta property="og:description" content="{{ summary }}">
<meta property="og:site_name" content="Houston">
<meta property="og:locale" content="{{ 'es_ES' if cert.lang == 'es' else 'en_US' }}">
<meta name="twitter:title" content="{{ headline }}">
<meta name="twitter:description" content="{{ summary }}">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "EducationalOccupationalCredential",
  "name": {{ json(credentialName) }},
  "credentialCategory": "certificate",
  "identifier": {{ json(cert.code) }},
  "url": {{ json(cert.pageUrl) }},{% if cert.eventDate %}
  "dateCreated": {{ json(cert.eventDate) }},{% endif %}
  "about": {
    "@type": "Event",
    "name": {{ json(cert.eventTitle) }}{% if cert.eventDate %},
    "startDate": {{ json(cert.eventDate) }}{% endif %}{% if cert.location %},
    "location": { "@type": "Place", "name": {{ json(cert.location) }} }{% endif %}
  },
  "recognizedBy": {
    "@type": "Organization",
    "name": "Houston",
    "url": "https://gethouston.ai/"
  }
}
</script>
{% endblock %}

{% block subpageStyles %}
<link rel="stylesheet" href="/assets/css/certificates.css">
{% endblock %}

{% block subpageContent %}
<div class="cert-wrap cert-wrap-wide">
  <p class="cert-eyebrow">{{ c.shareEyebrow }}</p>

  {# The artefact leads the page. Never lazy: it IS the content, and it is what
     a visitor arriving from a shared link came to see. #}
  <figure class="cert-frame">
    <img src="{{ cert.imageUrl }}" width="2000" height="1414" alt="{{ imageAlt }}"
      decoding="async" fetchpriority="high">
  </figure>

  <div class="cert-meta">
    <h1 class="cert-name">{{ cert.displayName }}</h1>
    <p class="cert-event">
      {{ cert.eventTitle }}{% if eventMeta %}<br>
      {{ eventMeta }}{% endif %}
    </p>
    <p class="cert-code">
      <span class="cert-code-label">{{ c.codeLabel }}</span>{{ cert.code }}
    </p>
  </div>

  <div class="cert-actions">
    <div class="cert-row">
      <a class="btn btn-ink" href="{{ liAdd }}" target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"/></svg>
        {{ c.addToLinkedIn }}
      </a>
      <a class="btn btn-outline" href="{{ cert.imageUrl }}" download="houston-certificate-{{ cert.code }}.png">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5 5 5-5"/><path d="M12 15V3"/></svg>
        {{ c.download }}
      </a>
    </div>

    <p class="cert-share-label">{{ c.shareLabel }}</p>
    <div class="cert-row">
      <a class="btn btn-outline btn-sm" href="https://www.linkedin.com/sharing/share-offsite/?url={{ utmLinkedIn | urlencode }}" target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"/></svg>
        LinkedIn
      </a>
      <a class="btn btn-outline btn-sm" href="https://twitter.com/intent/tweet?text={{ shareText | urlencode }}&amp;url={{ utmX | urlencode }}" target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.9 1.15h3.68l-8.04 9.19L24 22.85h-7.41l-5.8-7.58-6.64 7.58H.46l8.6-9.83L0 1.15h7.59l5.24 6.93 6.07-6.93zm-1.29 19.5h2.04L6.49 3.24H4.3l13.31 17.41z"/></svg>
        X
      </a>
      <a class="btn btn-outline btn-sm" href="https://api.whatsapp.com/send?text={{ (shareText + ' ' + utmWhatsApp) | urlencode }}" target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.39-1.47-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.19 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35M12.05 21.8h-.02a9.8 9.8 0 0 1-4.99-1.37l-.36-.21-3.71.97.99-3.62-.23-.37a9.8 9.8 0 0 1-1.5-5.23c0-5.41 4.4-9.81 9.83-9.81a9.75 9.75 0 0 1 6.94 2.88 9.75 9.75 0 0 1 2.87 6.94c0 5.41-4.4 9.82-9.82 9.82M20.5 3.49A11.8 11.8 0 0 0 12.05 0C5.5 0 .18 5.32.18 11.86c0 2.09.55 4.13 1.59 5.93L.08 24l6.35-1.66a11.85 11.85 0 0 0 5.66 1.44h.01c6.54 0 11.87-5.32 11.87-11.86 0-3.17-1.23-6.15-3.47-8.39"/></svg>
        WhatsApp
      </a>
      <button type="button" class="btn btn-outline btn-sm cert-copy" id="certCopy" data-url="{{ utmCopy }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
        <span class="cert-copy-idle">{{ c.copyLink }}</span>
        <span class="cert-copy-done">{{ c.copied }}</span>
      </button>
    </div>
  </div>

  <p class="cert-foot">
    {{ c.verifyFoot }}
    <a href="/certificates/verify/?code={{ cert.code | urlencode }}">gethouston.ai/certificates/verify</a>.
  </p>
</div>
{% include "certificates/share-scripts.njk" %}
{% endblock %}
