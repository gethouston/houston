{# The landing's structured data. Offers render from _data/pricing.js: the free
   tier at 0, then the Team seat billed monthly (per month) and billed yearly
   (per year), each with a UnitPriceSpecification naming its interval. #}
<script type="application/ld+json">
{ "@context":"https://schema.org","@type":"SoftwareApplication","name":"Houston","applicationCategory":"BusinessApplication","operatingSystem":"macOS, Windows","offers":[{"@type":"Offer","name":"{{ t.pricing.free.name }}","price":"0","priceCurrency":"{{ pricing.currencyCode }}"},{"@type":"Offer","name":"{{ t.pricing.team.name }} ({{ t.pricing.period.month }})","price":"{{ pricing.teamMonthly }}","priceCurrency":"{{ pricing.currencyCode }}","priceSpecification":{"@type":"UnitPriceSpecification","price":"{{ pricing.teamMonthly }}","priceCurrency":"{{ pricing.currencyCode }}","unitText":"{{ t.pricing.team.unit }}","referenceQuantity":{"@type":"QuantitativeValue","value":1,"unitCode":"MON"}}},{"@type":"Offer","name":"{{ t.pricing.team.name }} ({{ t.pricing.period.year }})","price":"{{ pricing.teamYearly }}","priceCurrency":"{{ pricing.currencyCode }}","priceSpecification":{"@type":"UnitPriceSpecification","price":"{{ pricing.teamYearly }}","priceCurrency":"{{ pricing.currencyCode }}","unitText":"{{ t.pricing.team.unitYearly }}","referenceQuantity":{"@type":"QuantitativeValue","value":1,"unitCode":"ANN"}}}],"downloadUrl":"https://github.com/gethouston/houston/releases","softwareVersion":"beta","description":"{{ t.meta.jsonLdDescription }}" }
</script>
