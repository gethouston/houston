{# Quiet stat band before pricing: "will it work with my stack?" answered in
   four tiles and ~25 words. Numbers are real claims (integrations count from
   the existing site, model count from the provider catalog). #}
<div class="stats-band reveal reveal-d1" role="group" aria-label="Works with your stack">
  <div class="stat">
    <span class="stat-n">1,000+</span>
    <span class="stat-l">integrations, the tools you already use</span>
  </div>
  <div class="stat">
    <span class="stat-n">400+</span>
    <span class="stat-l">models, switch per agent</span>
  </div>
  <div class="stat">
    <span class="stat-n">Your AI plan</span>
    <span class="stat-l">ChatGPT or Claude, no second bill</span>
  </div>
  <div class="stat">
    <span class="stat-n">Local models</span>
    <span class="stat-l">one computer serves the whole team</span>
  </div>
</div>
