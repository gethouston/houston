{#- The Guides hub is per locale (Spanish has its own at /guides/es/), so the
    path travels in the copy tree. Anything that is not a path falls back to the
    English hub, so a locale without its own guides never emits a broken link. -#}
{%- set guidesHref = t.nav.links.guides -%}
<a class="skip-link" href="#main">{{ t.nav.skip }}</a>
<nav class="lnav{% if subpage %} lnav-solid{% endif %}" id="lnav" aria-label="{{ t.nav.primary }}">
  <a class="lnav-brand" href="{{ localeRoot }}">Houston</a>
  <div class="lnav-links">
    <a href="{{ root }}#multiplayer">{{ t.nav.multiplayer }}</a>
    <a href="{{ root }}#agents">{{ t.nav.agents }}</a>
    <a href="{{ root }}#compound">{{ t.nav.features }}</a>
    <a href="{{ root }}#pricing">{{ t.nav.pricing }}</a>
    <a href="{{ root }}#faq">{{ t.nav.faq }}</a>
    {# Resources: everything that leaves the page, one quiet menu. #}
    <div class="lnav-res" id="lnav-res" data-menu>
      <button class="lnav-res-btn" id="lnav-res-btn" aria-haspopup="true" aria-expanded="false" aria-controls="lnav-res-menu">{{ t.nav.resources }}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button>
      <div class="lnav-res-menu" id="lnav-res-menu" role="menu">
        <a role="menuitem" href="https://agents.gethouston.ai">{{ t.nav.agentStore }}</a>
        <a role="menuitem" href="{{ guidesHref }}">{{ t.nav.guides }}</a>
        <a role="menuitem" href="/vision/">{{ t.nav.vision }}</a>
        <a role="menuitem" href="/changelog/">{{ t.nav.changelog }}</a>
      </div>
    </div>
  </div>
  <div class="lnav-right">
    <a class="lnav-icon" href="https://github.com/gethouston/houston" target="_blank" rel="noopener noreferrer" aria-label="{{ t.nav.githubLabel }}">
      <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
    </a>
    {# Language: the Resources menu shape reused, so one [data-menu] binding
       drives both. The button carries the current locale's short code. #}
    <div class="lnav-res lnav-lang" id="lnav-lang" data-menu>
      <button class="lnav-res-btn" id="lnav-lang-btn" aria-haspopup="true" aria-expanded="false" aria-controls="lnav-lang-menu" aria-label="{{ t.nav.langLabel }}">{{ locale.short }}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button>
      <div class="lnav-res-menu" id="lnav-lang-menu" role="menu">
        {%- for code in locales.order %}
        <a role="menuitem" href="{{ locales[code].dir }}" data-lang-choice="{{ code }}"{% if code == locale.code %} class="is-active" aria-current="true"{% endif %}>{{ locales[code].label }}</a>
        {%- endfor %}
      </div>
    </div>
    <button class="lnav-cta" data-dl-trigger data-dl-source="nav"><span class="lnav-cta-glyph" aria-hidden="true"></span>{{ t.nav.download }}</button>
    <button class="lnav-burger" id="lnav-burger" aria-label="{{ t.nav.menu }}" aria-controls="lnav-drop" aria-expanded="false">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" id="lnav-burger-icon" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>
  </div>
</nav>
<div class="lnav-drop" id="lnav-drop">
  <a href="{{ root }}#multiplayer">{{ t.nav.multiplayer }}</a>
  <a href="{{ root }}#agents">{{ t.nav.agents }}</a>
  <a href="{{ root }}#compound">{{ t.nav.features }}</a>
  <a href="{{ root }}#pricing">{{ t.nav.pricing }}</a>
  <a href="{{ root }}#faq">{{ t.nav.faq }}</a>
  <a href="https://agents.gethouston.ai">{{ t.nav.agentStore }}</a>
  <a href="{{ guidesHref }}">{{ t.nav.guides }}</a>
  <a href="/vision/">{{ t.nav.vision }}</a>
  <a href="/changelog/">{{ t.nav.changelog }}</a>
  <a href="https://github.com/gethouston/houston" target="_blank" rel="noopener noreferrer">{{ t.nav.github }}</a>
  {# Same three languages as the desktop menu, flattened into the sheet. #}
  {%- for code in locales.order %}
  <a class="lnav-drop-lang{% if code == locale.code %} is-active{% endif %}" href="{{ locales[code].dir }}" data-lang-choice="{{ code }}"{% if code == locale.code %} aria-current="true"{% endif %}>{{ locales[code].label }}</a>
  {%- endfor %}
</div>
