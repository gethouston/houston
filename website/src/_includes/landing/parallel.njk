{# One teammate face. `landing.people` holds the identity (photo file or
   initials + tone), `t.js.people` the display name. #}
{%- macro face(id) %}{% set p = landing.people[id] %}{% if p.img %}<span class="face face-img" title="{{ t.js.people[id] or p.initials }}"><img src="/assets/img/{{ p.img }}-48.webp" srcset="/assets/img/{{ p.img }}-96.webp 2x" width="48" height="48" alt=""></span>{% else %}<span class="face {{ p.tone }}" title="{{ t.js.people[id] or p.initials }}">{{ p.initials }}</span>{% endif %}{% endmacro -%}
<section id="parallel" class="section is-dark">
  {# Hidden alias: cross-site links to #agents land on the multi-agent story. #}
  <span id="agents" class="anchor-alias" aria-hidden="true"></span>

  {# Split: one agent's mission column left (real app card anatomy: agent
     helmet, human face stacks, status dots; top 5 of many missions shown),
     the why right. data-swap pills switch the agent; JS-off shows the first.
     The four columns are one loop: landing.parallel.agents carries the DOM
     order, the avatar tone and the face roster, t.parallel.agents the copy. #}
  <div class="split reveal">
    <div class="split-visual">
      <div class="acol-demo" data-swap-group="acol">
        <div class="chat-tabs acol-tabs" role="tablist" aria-label="{{ t.parallel.tabsLabel }}">
{%- for a in landing.parallel.agents %}
          <button class="chat-tab{% if loop.first %} active{% endif %}" data-swap="{{ loop.index0 }}" role="tab" aria-selected="{% if loop.first %}true{% else %}false{% endif %}">{{ t.parallel.agents[a.id].name }}</button>
{%- endfor %}
        </div>
{%- for a in landing.parallel.agents %}{% set ta = t.parallel.agents[a.id] %}{% set isFirst = loop.first %}
        <div class="acol swap-panel{% if isFirst %} active{% endif %}" role="img" aria-label="{{ ta.alt }}">
          <div class="acol-h"><span class="av {{ a.av }}" aria-hidden="true"></span>{{ ta.name }}<span class="acol-n">{{ ta.missionCount }}</span></div>
{%- for s in a.cards %}{% set c = ta.cards[loop.index0] %}
          <div class="tcard"><div class="tc-head"><span class="av {{ a.av }}" aria-hidden="true"></span><span class="tc-agent">{{ ta.name }}</span>{% if s.running %}<span class="ast ast-run" aria-hidden="true"></span>{% endif %}</div><div class="tc-title">{{ c.title }}</div><div class="tc-desc">{{ c.desc }}</div><div class="faces" role="group" aria-label="{{ t.parallel.peopleLabel }}">{% for id in s.people %}{{ face(id) }}{% endfor %}</div></div>
{%- endfor %}
          <div class="acol-more">{{ ta.more }}</div>
        </div>
{%- endfor %}
      </div>
    </div>

    <div class="split-copy">
      <h2 class="sec-title">{{ t.parallel.title }}</h2>
{%- for line in t.parallel.lines %}
      <p class="split-line">{{ line }}</p>
{%- endfor %}
      <a class="btn btn-ghost btn-sm split-cta" href="https://agents.gethouston.ai">{{ t.parallel.cta }}</a>
    </div>
  </div>
</section>
