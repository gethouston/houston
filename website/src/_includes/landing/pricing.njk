<section id="pricing" class="section">
  {# Hidden alias so cross-site links to #download land on the pricing + download
     CTAs rather than 404ing. #}
  <span id="download" class="anchor-alias" aria-hidden="true"></span>
  <div class="pricing-head reveal">
    <h2 class="sec-title pricing-title">Ready to 10x your team overnight?</h2>
    <p class="sec-lead">Free for the first three people. Upgrade when the whole team wants in.</p>
  </div>

  {# Annual price leads (the convention people expect); the monthly price is
     the small line. The Team card inverts to ink — the one loud object on the
     band. All prices render from _data/pricing.js, never hardcoded. #}
  <div class="pricing-grid reveal reveal-d1">
    <div class="price-col">
      <div class="price-name">Free</div>
      <div class="price-amt"><span class="amount">{{ pricing.currency }}0</span></div>
      <div class="price-note">for yourself, or a team of up to three</div>
      <ul class="price-list">
        <li>Your personal workspace, free forever</li>
        <li>Up to three people when you're ready</li>
        <li>All 1,000+ integrations</li>
        <li>Works with your AI subscription</li>
        <li>Community agents from the store</li>
      </ul>
      <div class="price-cta"><button class="btn btn-outline" data-dl-trigger data-dl-source="pricing">Download the app</button></div>
    </div>

    <div class="price-col featured">
      <span class="price-chip">Most popular</span>
      <div class="price-name">Team</div>
      <div class="price-amt"><span class="amount">{{ pricing.currency }}{{ pricing.teamAnnual }}</span><span class="per">/seat/mo</span></div>
      <div class="price-note">billed annually · {{ pricing.currency }}{{ pricing.teamMonthly }} billed monthly</div>
      <ul class="price-list">
        <li>Everything in Free</li>
        <li>Unlimited teammates</li>
        <li>Unlimited usage, agents around the clock</li>
        <li>Shared agents and team spaces</li>
        <li>Roles and guardrails</li>
      </ul>
      <div class="price-cta"><button class="btn btn-white" data-dl-trigger data-dl-source="pricing-team">Start free trial</button></div>
    </div>

    <div class="price-col">
      <div class="price-name">Enterprise</div>
      <div class="price-amt"><span class="amount">Custom</span></div>
      <div class="price-note">for larger teams</div>
      <ul class="price-list">
        <li>SSO</li>
        <li>Security review</li>
        <li>Onboarding for the whole team</li>
      </ul>
      <div class="price-cta"><a class="btn btn-outline" href="mailto:{{ pricing.salesEmail }}?subject=Houston%20Enterprise">Talk to us</a></div>
    </div>
  </div>
</section>
