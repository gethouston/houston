<section id="pricing" class="section is-panel">
  {# Hidden alias so cross-site links to #download land on the pricing + download
     CTAs rather than 404ing. #}
  <span id="download" class="anchor-alias" aria-hidden="true"></span>
  <div class="pricing-head reveal">
    <h2 class="sec-title pricing-title">Bring your whole team aboard.</h2>
    <p class="sec-lead">Free for the first three people. Upgrade when the whole team wants in.</p>
  </div>

  <div class="pricing-grid reveal reveal-d1">
    <div class="price-col">
      <div class="price-name">Free</div>
      <div class="price-amt"><span class="amount">$0</span></div>
      <p class="price-desc">Up to three people, limited usage. Enough to feel the value.</p>
      <div class="price-cta"><button class="btn btn-outline" data-dl-trigger data-dl-source="pricing">Download the app</button></div>
    </div>

    <div class="price-col featured">
      <div class="price-name">Team</div>
      <div class="price-amt"><span class="amount">{{ pricing.currency }}{{ pricing.teamMonthly }}</span><span class="per">/seat/mo</span></div>
      <div class="price-note">{{ pricing.currency }}{{ pricing.teamAnnual }}/seat/mo billed annually</div>
      <p class="price-desc">Unlimited usage, the whole team, agents around the clock.</p>
      <div class="price-cta"><button class="btn btn-ink" data-dl-trigger data-dl-source="pricing-team">Start free trial</button></div>
    </div>

    <div class="price-col">
      <div class="price-name">Enterprise</div>
      <div class="price-amt"><span class="amount">Custom</span></div>
      <p class="price-desc">Security, SSO, and onboarding for teams.</p>
      <div class="price-cta"><a class="btn btn-outline" href="mailto:{{ pricing.salesEmail }}?subject=Houston%20Enterprise">Talk to us</a></div>
    </div>
  </div>
</section>
