<section id="pricing" class="section">
  {# Hidden alias so cross-site links to #download land on the pricing + download
     CTAs rather than 404ing. #}
  <span id="download" class="anchor-alias" aria-hidden="true"></span>
  <div class="pricing-head reveal">
    <h2 class="sec-title pricing-title">{{ t.pricing.title }}</h2>
    <p class="sec-lead">{{ t.pricing.lead }}</p>
  </div>

  {# Annual price leads (the convention people expect); the monthly price is
     the small line. The Team card inverts to ink, the one loud object on the
     band. All prices render from _data/pricing.js, never hardcoded, and the
     Team note takes its monthly figure through the {price} placeholder so no
     translation ever carries a number. #}
  <div class="pricing-grid reveal reveal-d1">
    <div class="price-col">
      <div class="price-name">{{ t.pricing.free.name }}</div>
      <div class="price-amt"><span class="amount">{{ pricing.currency }}0</span></div>
      <div class="price-note">{{ t.pricing.free.note }}</div>
      <ul class="price-list">
{%- for item in t.pricing.free.items %}
        <li>{{ item }}</li>
{%- endfor %}
      </ul>
      <div class="price-cta"><button class="btn btn-outline" data-dl-trigger data-dl-source="pricing">{{ t.pricing.free.cta }}</button></div>
    </div>

    <div class="price-col featured">
      <span class="price-chip">{{ t.pricing.team.chip }}</span>
      <div class="price-name">{{ t.pricing.team.name }}</div>
      <div class="price-amt"><span class="amount">{{ pricing.currency }}{{ pricing.teamAnnual }}</span><span class="per">{{ t.pricing.team.per }}</span></div>
      <div class="price-note">{{ t.pricing.team.note | replace("{price}", pricing.currency + pricing.teamMonthly) }}</div>
      <ul class="price-list">
{%- for item in t.pricing.team.items %}
        <li>{{ item }}</li>
{%- endfor %}
      </ul>
      <div class="price-cta"><button class="btn btn-white" data-dl-trigger data-dl-source="pricing-team">{{ t.pricing.team.cta }}</button></div>
    </div>

    <div class="price-col">
      <div class="price-name">{{ t.pricing.enterprise.name }}</div>
      <div class="price-amt"><span class="amount">{{ t.pricing.enterprise.amount }}</span></div>
      <div class="price-note">{{ t.pricing.enterprise.note }}</div>
      <ul class="price-list">
{%- for item in t.pricing.enterprise.items %}
        <li>{{ item }}</li>
{%- endfor %}
      </ul>
      <div class="price-cta"><a class="btn btn-outline" href="mailto:{{ pricing.salesEmail }}?subject=Houston%20Enterprise">{{ t.pricing.enterprise.cta }}</a></div>
    </div>
  </div>
</section>
