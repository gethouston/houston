{%- set cur = pricing.currency[locale.code] %}
{%- set save = pricing.teamYearlySavePercent %}
{#- data-period picks which Team price shows: "year" until the switch below
    says otherwise, so a visitor without JS sees the yearly price too. #}
<section id="pricing" class="section" data-period="year">
  {# Hidden alias so cross-site links to #download land on the pricing + download
     CTAs rather than 404ing. #}
  <span id="download" class="anchor-alias" aria-hidden="true"></span>
  <div class="pricing-head reveal">
    <h2 class="sec-title pricing-title">{{ t.pricing.title }}</h2>
    {# Hidden until html.js is set (before first paint), so a visitor without
       JS never sees a switch that does nothing, and nothing shifts. The
       Yearly button's aria-label reads its badge as one phrase ("Yearly,
       save 25%") instead of two run-together labels. #}
    <div class="price-period" role="group" aria-label="{{ t.pricing.period.label }}">
      <button type="button" data-period-choice="month" aria-pressed="false">{{ t.pricing.period.month }}</button>
      <button type="button" data-period-choice="year" aria-pressed="true" aria-label="{{ t.pricing.period.yearName | replace("{save}", save) }}">{{ t.pricing.period.year }}<span class="price-save">{{ t.pricing.period.save | replace("{save}", save) }}</span></button>
    </div>
  </div>

  {# The Team card inverts to ink, the one loud object on the band. Every price
     renders from _data/pricing.js, so no translation ever carries a number.
     Both Team prices and notes are in the page, stacked in one grid cell
     (.price-swap) so the card keeps the size of the larger one whichever shows. #}
  <div class="pricing-grid reveal reveal-d1">
    <div class="price-col">
      <div class="price-name">{{ t.pricing.free.name }}</div>
      <div class="price-amt"><span class="amount">{{ cur }}0</span></div>
      <div class="price-note">{{ t.pricing.free.note }}</div>
      <ul class="price-list">
{%- for item in t.pricing.free.items %}
        <li>{{ item }}</li>
{%- endfor %}
      </ul>
      <div class="price-cta"><button class="btn btn-outline" data-dl-trigger data-dl-source="pricing">{{ t.pricing.free.cta }}</button></div>
    </div>

    <div class="price-col featured">
      <span class="price-chip">{{ t.pricing.team.chip }}</span>
      <div class="price-name">{{ t.pricing.team.name }}</div>
      <div class="price-amt" aria-live="polite"><span class="amount price-swap"><span data-show="month">{{ cur }}{{ pricing.teamMonthly }}</span><span data-show="year">{{ cur }}{{ pricing.teamYearlyPerMonth }}</span></span><span class="per">{{ t.pricing.team.per }}</span></div>
      <div class="price-note price-swap"><span data-show="month">{{ t.pricing.team.note }}</span><span data-show="year">{{ t.pricing.team.noteYearly | replace("{yearlyTotal}", cur + pricing.teamYearly) }}</span></div>
      <ul class="price-list">
{%- for item in t.pricing.team.items %}
        <li>{{ item }}</li>
{%- endfor %}
      </ul>
      <div class="price-cta"><button class="btn btn-white" data-dl-trigger data-dl-source="pricing-team">{{ t.pricing.team.cta }}</button></div>
    </div>

    <div class="price-col">
      <div class="price-name">{{ t.pricing.enterprise.name }}</div>
      <div class="price-amt"><span class="amount">{{ t.pricing.enterprise.amount }}</span></div>
      <div class="price-note">{{ t.pricing.enterprise.note }}</div>
      <ul class="price-list">
{%- for item in t.pricing.enterprise.items %}
        <li>{{ item }}</li>
{%- endfor %}
      </ul>
      <div class="price-cta"><a class="btn btn-outline" href="{{ localeRoot }}{{ enterprise.path }}">{{ t.pricing.enterprise.cta }}</a></div>
    </div>
  </div>
</section>
<script>
  // The Monthly / Yearly switch: one attribute on the section, which the CSS
  // reads to show the matching Team price and note.
  (function () {
    var section = document.getElementById("pricing");
    if (!section) return;
    var buttons = section.querySelectorAll("[data-period-choice]");
    Array.prototype.forEach.call(buttons, function (button) {
      button.addEventListener("click", function () {
        section.setAttribute("data-period", button.getAttribute("data-period-choice"));
        Array.prototype.forEach.call(buttons, function (other) {
          other.setAttribute("aria-pressed", other === button ? "true" : "false");
        });
      });
    });
  })();
</script>
