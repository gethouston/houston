<header class="hero">
  {# The hero backdrop is ONE swappable element: Julian's AI-sky image (LCP),
     dissolving into the ivory page before the fold ends. #}
  <div class="hero-photo" aria-hidden="true">
    <img class="hero-sky"
      src="/assets/img/ai-sky.webp"
      srcset="/assets/img/ai-sky-mobile.webp 900w, /assets/img/ai-sky.webp 1672w"
      sizes="100vw"
      width="1672" height="941"
      fetchpriority="high" decoding="async" alt="">
  </div>

  <div class="hero-fold">
    <div class="hero-intro hero-load">
      <h1 class="hero-h1">The shared workspace where people and agents work together.</h1>
      <p class="hero-sub">Your sales team shares the sales agents. Every learning compounds, and all of it stays in your company.</p>
      <div class="hero-cta">
        <button class="btn btn-ink" data-dl-trigger data-dl-source="hero">Download the app</button>
        <p class="hero-proof">Free to try. Your team joins when you're ready.</p>
      </div>
    </div>

