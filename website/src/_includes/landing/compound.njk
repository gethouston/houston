            <div class="feat-row"><span class="feat-note">CC the deal owner before anything sends</span><span class="face face-img feat-face" title="Julian"><img src="/assets/img/julian-48.webp" srcset="/assets/img/julian-96.webp 2x" width="48" height="48" alt="Julian"></span></div>
            <div class="feat-row"><span class="feat-note">Count renewals from the contract date</span><span class="feat-meta">this week</span></div>
            <div class="feat-row"><span class="feat-note">Discounts above 15% need a sign-off</span><span class="face face-img feat-face" title="Julian"><img src="/assets/img/julian-48.webp" srcset="/assets/img/julian-96.webp 2x" width="48" height="48" alt="Julian"></span></div>
            <div class="feat-row"><span class="feat-note">Log every call in HubSpot, same day</span><span class="face hp-3 feat-face" title="Maya">M</span></div>
