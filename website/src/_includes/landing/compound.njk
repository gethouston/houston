<section id="compound" class="section">
  {# Split, reversed: statement left, one agent's "everything it carries"
     right. Pills swap five static views of the SAME agent: learnings, skills,
     context, integrations, permissions. Same data-swap mechanic as #parallel;
     JS-off shows Learnings settled. Team-taught learnings carry the teammate's
     avatar; integrations carry the real tool marks. #}
  <div class="split split-rev reveal">
    <div class="split-copy">
      <div class="eyebrow-mono">Compounding</div>
      <h2 class="sec-title">What your agents learn, stays.</h2>
      <p class="split-line">Everything any of your agents carries lives with it, shared by the whole team. New people start with all of it, and none of it walks out the door.</p>
    </div>

    <div class="split-visual">
      <div class="feat-demo" data-swap-group="feat">
        <div class="chat-tabs feat-tabs" role="tablist" aria-label="What the agent carries">
          <button class="chat-tab active" data-swap="0" role="tab" aria-selected="true">Learnings</button>
          <button class="chat-tab" data-swap="1" role="tab" aria-selected="false">Skills</button>
          <button class="chat-tab" data-swap="2" role="tab" aria-selected="false">Context</button>
          <button class="chat-tab" data-swap="3" role="tab" aria-selected="false">Integrations</button>
          <button class="chat-tab" data-swap="4" role="tab" aria-selected="false">Permissions</button>
        </div>

        <div class="share-mock feat-card">
          <div class="shm-head">
            <span class="av av-c" aria-hidden="true"></span>
            <span class="shm-title">Sales Rep<span class="shm-sub">Shared agent · Acme Studio</span></span>
          </div>

          <div class="swap-panel active" role="img" aria-label="The agent's learnings, taught by the team: churned accounts excluded, deal owners copied, renewals from contract date, discount sign-offs, calls logged in HubSpot">
