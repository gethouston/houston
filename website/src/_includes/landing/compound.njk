<section id="compound" class="section">
  {# Split, reversed: statement left, the Share dialog artifact right. The
     share card mirrors the real app's Share dialog anatomy (agent, members
     with Manager / Can use roles) with the real teammate photos. Static on
     purpose: it is the proof object for permissions + compounding knowledge. #}
  <div class="split split-rev reveal">
    <div class="split-copy">
      <div class="eyebrow-mono">Compounding</div>
      <h2 class="sec-title">What your agents learn, stays.</h2>
      <p class="split-line">Every correction teaches the agent for the whole team. New people start with everything it knows, and none of it walks out the door.</p>
    </div>

    <div class="split-visual">
      <div class="share-mock" role="img" aria-label="Sharing the Sales Rep agent: Julian manages it, Felipe can use it, and a teammate can be invited">
        <div class="shm-head">
          <span class="av av-c" aria-hidden="true"></span>
          <span class="shm-title">Sales Rep<span class="shm-sub">Shared agent · Acme Studio</span></span>
        </div>
        <div class="shm-row">
          <span class="face face-img" aria-hidden="true"><img src="/assets/img/julian-48.webp" srcset="/assets/img/julian-96.webp 2x" width="48" height="48" alt=""></span>
          <span class="shm-name">Julian</span>
          <span class="shm-role">Manager</span>
        </div>
        <div class="shm-row">
          <span class="face face-img" aria-hidden="true"><img src="/assets/img/felipe-48.webp" srcset="/assets/img/felipe-96.webp 2x" width="48" height="48" alt=""></span>
          <span class="shm-name">Felipe</span>
          <span class="shm-role shm-role-use">Can use</span>
        </div>
        {# Maya joins on a slow loop (CSS keyframes): the invite row pulses,
           then she appears with her role. Reduced-motion shows her settled. #}
        <div class="shm-row shm-new">
          <span class="face hp-3" aria-hidden="true">M</span>
          <span class="shm-name">Maya</span>
          <span class="shm-role shm-role-use">Can use</span>
        </div>
        <div class="shm-row shm-invite">
          <span class="shm-plus" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg></span>
          <span class="shm-name">Invite a teammate</span>
        </div>
      </div>
    </div>
  </div>
</section>
