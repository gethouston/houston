{% from "enterprise/icons.njk" import arrow %}
{%- set d = t.dataPartners -%}
{%- set reel = dataPartners.reelDir -%}
{# The fold, /enterprise's own (enterprise/hero.njk): the same reel of real
   operations under one huge light statement and two ways in. The reel is
   run by assets/enterprise-reel.js; without JS or with reduced motion the
   first poster stands. #}
<header class="hero ent-hero" id="top" data-tone="dark">
  <div class="ent-reel" id="ent-reel" aria-hidden="true">
{%- for clip in dataPartners.reel %}
    <video class="ent-reel-clip{% if loop.first %} is-on{% endif %}" muted playsinline preload="{{ 'metadata' if loop.first else 'none' }}" poster="{{ reel }}/{{ clip }}.webp" width="1280" height="720"><source src="{{ reel }}/{{ clip }}.mp4" type="video/mp4"></video>
{%- endfor %}
  </div>

  <div class="hero-fold ent-fold">
    <div class="hero-intro hero-load">
      <h1 class="ent-h1">{% for line in d.hero.h1Lines %}<span>{{ line }}</span>{% if not loop.last %} {% endif %}{% endfor %}</h1>
      <p class="ent-sub">{{ d.hero.sub }}</p>
      <div class="hero-cta">
        <a class="btn btn-white" href="#estimate">{{ d.hero.ctaEstimate }}{{ arrow() }}</a>
        <a class="btn btn-ghost" href="{{ dataPartners.booking }}" target="_blank" rel="noopener">{{ d.hero.ctaBook }}</a>
      </div>
    </div>
  </div>
</header>
