{%- set e = t.enterprise -%}
{%- set s = e.solution -%}
{%- set count = s.phases.length + 1 -%}
{%- macro chevronRight() %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>{% endmacro -%}
{#- One slide: a big title, then a smaller line under it with air between,
    the two levels of the proof band. The first slide is the section title,
    so it is the heading. Every slide ends on the booking pill, so whoever
    is ready can book from any step. -#}
{%- macro slide(index, count, head, rest, tag, cta) %}
      <div class="ent-slide{% if index == 0 %} is-on{% endif %}" role="group" aria-roledescription="slide" aria-label="{{ index + 1 }} / {{ count }}" data-slide="{{ index }}">
        <{{ tag }} class="ent-slide-head">{{ head }}</{{ tag }}>
        <p class="ent-slide-rest">{{ rest }}</p>
        <a class="ent-slide-cta" href="{{ cta.href }}" target="_blank" rel="noopener">{{ cta.label }}{{ chevronRight() }}</a>
      </div>
{%- endmacro -%}
{# How we solve it: the whole story as ONE slide at a time, centered in the
   middle of the screen. The title opens it and each phase follows; a solid
   round button with a chevron sits to the right of the text so the way
   forward is obvious, a quiet one to the left goes back, and the marks under
   it say where you are. Nothing moves on its own; on the last slide the
   chevron steps aside (assets/enterprise-process.js).

   Without JS every slide stands, one under the other, and the buttons do
   nothing. #}
<section id="solution" class="section ent-section ent-process-sec" data-tone="light">
  <div class="ent-slider reveal" data-slider role="region" aria-roledescription="carousel" aria-label="{{ s.title }}" tabindex="0">
    <button class="ent-arrow ent-arrow-prev" type="button" data-prev aria-label="{{ s.prev }}" disabled><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg></button>

    <div class="ent-slides">
{{ slide(0, count, s.title, s.lead, "h2", { href: enterprise.contact.booking, label: s.bookCall }) }}
{%- for phase in s.phases %}
{{ slide(loop.index, count, phase.head, phase.rest, "p", { href: enterprise.contact.booking, label: s.bookCall }) }}
{%- endfor %}
    </div>

    <button class="ent-arrow ent-arrow-next" type="button" data-next aria-label="{{ s.next }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></button>

    <span class="ent-dots" aria-hidden="true">{% for i in range(0, count) %}<i{% if i == 0 %} class="is-on"{% endif %}></i>{% endfor %}</span>
  </div>
</section>
