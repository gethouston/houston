{% from "enterprise/icons.njk" import arrow %}
{%- set e = t.enterprise -%}
{%- set reel = enterprise.reelDir -%}
{# The fold: a reel of real operations (industries in pairs: the industry, then a person in it on a tablet) under one
   huge light statement and two ways in. Nothing else.

   assets/enterprise-reel.js runs it. Without JS, or with reduced motion,
   nothing plays: the first clip's poster frame stands. Layout mechanics come
   from the B2C fold (landing-hero.css). #}
<header class="hero ent-hero" id="top" data-tone="dark">
  <div class="ent-reel" id="ent-reel" aria-hidden="true">
{%- for clip in enterprise.reel %}
    <video class="ent-reel-clip{% if loop.first %} is-on{% endif %}" muted playsinline preload="{{ 'metadata' if loop.first else 'none' }}" poster="{{ reel }}/{{ clip }}.webp" width="1280" height="720"><source src="{{ reel }}/{{ clip }}.mp4" type="video/mp4"></video>
{%- endfor %}
  </div>

  <div class="hero-fold ent-fold">
    <div class="hero-intro hero-load">
      <h1 class="ent-h1">{% for line in e.hero.h1Lines %}<span>{{ line }}</span>{% if not loop.last %} {% endif %}{% endfor %}</h1>
      <p class="ent-sub">{{ e.hero.sub }}</p>
      <div class="hero-cta">
        <a class="btn btn-white" href="{{ enterprise.contact.booking }}" target="_blank" rel="noopener">{{ e.hero.ctaDemo }}{{ arrow() }}</a>
        <a class="btn btn-ghost" href="#solution">{{ e.hero.ctaHow }}</a>
      </div>
    </div>
  </div>
</header>
