<!DOCTYPE html>
<html lang="{{ locale.htmlLang }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{% block title %}{{ title }}{% endblock %}</title>
{# The default social card. It is a block so a page that owns a UNIQUE image
    (certificate share pages: one generated 1200x630 card per attendee) can
    replace the whole set instead of emitting a second, conflicting og:image
    from the meta block below. Default renders byte-identical to before, so
    every existing page is unchanged. -#}
<!-- Default social card (per-page blocks can override meta) -->
{% block socialImage %}<meta property="og:image" content="https://gethouston.ai/og-image.jpg">
<meta property="og:image:secure_url" content="https://gethouston.ai/og-image.jpg">
<meta property="og:image:type" content="image/jpeg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ t.meta.ogImageAlt }}">
<meta name="twitter:image" content="https://gethouston.ai/og-image.jpg">
<meta name="twitter:image:alt" content="{{ t.meta.ogImageAlt }}">{% endblock %}
{% block meta %}{% endblock %}
{% block favicon %}<link rel="icon" type="image/svg+xml" href="/favicon.svg">{% endblock %}
{% if noindex %}<meta name="robots" content="noindex,nofollow">{% endif %}
{# Canonical. A block because pages whose permalink ends in `.html` but whose
    public URL does not (the /c/<CODE>.html certificate pages, served at
    /c/<CODE>) must point at the public URL, not at `page.url`. Default is
    byte-identical to before. -#}
{% block canonical %}<link rel="canonical" href="https://gethouston.ai{{ page.url }}">{% endblock %}

<script type="application/ld+json">
{ "@context":"https://schema.org","@type":"Organization","name":"Houston","url":"https://gethouston.ai/","logo":"https://gethouston.ai/houston-icon.png","sameAs":["https://github.com/gethouston/houston","https://www.linkedin.com/company/get-houston"] }
</script>

<script type="application/ld+json">
{ "@context":"https://schema.org","@type":"WebSite","name":"Houston","url":"https://gethouston.ai/" }
</script>
{# General Sans (Fontshare) is the type for every subpage. It's an overridable
   block so the rebuilt landing (index.njk), which uses zero General Sans, can
   drop this render-blocking request. Default keeps it, so all other pages are
   unchanged. #}
{% block fonts %}<link href="https://api.fontshare.com/v2/css?f[]=general-sans@500,600,700&display=swap" rel="stylesheet">{% endblock %}
{% block stylesheets %}{% endblock %}
{% block inlineStyles %}{% endblock %}
{# Scripts that must run BEFORE analytics init (e.g. stripping a secret query
   param from the URL so PostHog/GA never capture it in the pageview). #}
{% block headScripts %}{% endblock %}
{# ── Analytics identity of this page ──────────────────────────────────────────
   A page whose title or URL carries personal data (the certificate share pages
   put the attendee's real name in <title> and their code in the path) sets
   `analyticsTitle` + `analyticsPath` in its front matter. Both SDKs then report
   THOSE instead of the real ones, while the query string is kept so a shared
   link's UTMs still attribute. Every other page is unchanged: with no
   `analyticsTitle` the two snippets below render exactly as they always did. #}
{% if env.posthogKey %}
<script>
  !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init me ws ys ps bs capture je Di ks register register_once register_for_session unregister unregister_for_session Ps getFeatureFlag getFeatureFlagPayload isFeatureEnabled reloadFeatureFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSurveysLoaded onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey canRenderSurveyAsync identify setPersonProperties group resetGroups setPersonPropertiesForFlags resetPersonPropertiesForFlags getGroups setGroupPropertiesForFlags resetGroupPropertiesForFlags reset get_distinct_id getGroups get_session_id get_session_replay_url alias set_config startSessionRecording stopSessionRecording sessionRecordingStarted captureException loadToolbar get_property getSessionProperty Es $s createPersonProfile Is opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing clear_opt_in_out_capturing Ss debug xs getPageViewId captureTraceFeedback captureTraceMetric".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
  posthog.init('{{ env.posthogKey }}', {
    api_host: '{{ env.posthogHost }}',
    defaults: '2026-01-30',
    // 'always' = anonymous visitors get a person profile too, so $initial_utm_*
    // gets captured on first pageview. Otherwise PostHog defers profile
    // creation until identify() is called, and the UTM data is lost. The
    // app's post-install /welcome bounce then identifies(install_id) which
    // merges that anonymous profile (with UTMs) into the install identity.
    person_profiles: 'always',
    {# Automatic capture reads document.title and location.href, which is
       exactly what a sanitized page must not send. Those pages send their own
       $pageview from `loaded` below instead. #}
    capture_pageview: {{ "false" if analyticsTitle else "true" }},
    capture_pageleave: {{ "false" if analyticsTitle else "true" }},
    autocapture: false,
    disable_session_recording: true,
    enable_heatmaps: false,
    respect_dnt: true,
    advanced_disable_flags: true,
    loaded: function (ph) { ph.register({ source: 'website' });{% if analyticsTitle %}
      ph.capture('$pageview', {
        title: {{ analyticsTitle | dump | safe }},
        $current_url: window.location.origin + {{ analyticsPath | dump | safe }} + window.location.search
      });{% endif %} }
  });
</script>
{% endif %}
{% if env.gaMeasurementId %}
<!-- Google Analytics 4 (gtag.js) — loaded once site-wide via this base layout.
     Static multi-page site: every navigation is a full load, so gtag's config
     call emits page_view on each page. No SPA route tracking needed; GA4
     enhanced measurement (configured in the GA UI) covers scroll, outbound
     clicks and file downloads. Conversion events are forwarded from the
     existing track() helper, so PostHog and GA stay in sync with no duplicate
     pageviews and no second Google tag. -->
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  // Consent Mode v2. This site runs no advertising, so all ad signals are
  // denied by default. Analytics mirrors the existing PostHog posture: on by
  // default but disabled when the visitor has Do Not Track enabled
  // (PostHog uses respect_dnt: true above).
  var __houstonDNT = (navigator.doNotTrack == '1' || window.doNotTrack == '1' || navigator.msDoNotTrack == '1');
  gtag('consent', 'default', {
    ad_storage: 'denied',
    ad_user_data: 'denied',
    ad_personalization: 'denied',
    analytics_storage: __houstonDNT ? 'denied' : 'granted'
  });
  gtag('js', new Date());
  {# GA4 forbids PII in any parameter, and `page_title` / `page_location`
     default to the document's real ones. Overriding them here applies to every
     event on the page, including enhanced measurement. #}
  gtag('config', '{{ env.gaMeasurementId }}'{% if analyticsTitle %}, {
    page_title: {{ analyticsTitle | dump | safe }},
    page_location: window.location.origin + {{ analyticsPath | dump | safe }} + window.location.search
  }{% endif %});
</script>
<script async src="https://www.googletagmanager.com/gtag/js?id={{ env.gaMeasurementId }}"></script>
{% endif %}
</head>
<body>
{% block body %}{% endblock %}
</body>
</html>
