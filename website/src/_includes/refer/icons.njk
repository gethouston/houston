{# The glyphs /data-partners/refer repeats: one per company category and per
   step (ids from _data/refer.js), and the small marks the request board and
   each request's page wear (all, search, bonus, company, assurance, no).
   Decorative: every element that embeds one carries its own visible label. #}
{%- macro svg(paths) -%}
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{{ paths | safe }}</svg>
{%- endmacro -%}

