{%- set r = t.refer -%}
{%- set f = r.form -%}
{#- The referral form card, on its own so it can sit in the fold of
    /data-partners/refer (refer/hero.njk) and in the form section of each
    request's page (refer/form.njk). On a request's page (`item` is its
    pagination alias) its industry is already chosen, and the request rides
    along in a hidden field so the team knows which one it answers.

    Sending stores the referral (assets/refer-send.js: Supabase
    public.data_referrals plus the team's sheet tab) and says so. If it cannot
    be stored, the form stays filled in and says so above the button. It never
    sends email: without JS the button stays disabled. -#}
{%- set listing = item.slug if item else "" -%}
{%- set industry = item.category if item else "" -%}
{#- Compact on purpose: three rows of two, the industry last, and the
    section names kept for screen readers only, so the whole card fits in
    the fold of a laptop screen beside the statement. -#}
{#- One labelled, required field. Every field owns an error line the script
    fills (assets/refer-form.js). -#}
{%- macro field(name, label, type, auto, placeholder, mode) %}
        <div class="rf-field">
          <label for="rf-{{ name }}">{{ label }}</label>
          <input id="rf-{{ name }}" name="{{ name }}" type="{{ type }}"{% if mode %} inputmode="{{ mode }}"{% endif %}{% if auto %} autocomplete="{{ auto }}"{% endif %}{% if placeholder %} placeholder="{{ placeholder }}"{% endif %} required aria-describedby="rf-{{ name }}-error">
          <p class="rf-error" id="rf-{{ name }}-error" hidden></p>
        </div>
{%- endmacro -%}
    <div class="rf-form-card">
      <form class="rf-form" id="rf-form" novalidate data-refer-form>
        <fieldset class="rf-group">
          <legend>{{ f.you }}</legend>
          <div class="rf-row">
{{ field("yourName", f.yourName, "text", "name") }}
{{ field("yourEmail", f.yourEmail, "email", "email") }}
          </div>
        </fieldset>

        <fieldset class="rf-group">
          <legend>{{ f.company }}</legend>
          <div class="rf-row">
{{ field("companyName", f.companyName, "text", "organization") }}
{{ field("website", f.website, "text", "url", f.websitePlaceholder) }}
          </div>
          <div class="rf-row">
{{ field("size", f.size, "text", "off", f.sizePlaceholder) }}
{{ field("years", f.years, "text", "off", f.yearsPlaceholder, "numeric") }}
          </div>
          <div class="rf-row">
            <div class="rf-field">
              <label for="rf-industry">{{ f.industry }}</label>
              <select id="rf-industry" name="industry" required aria-describedby="rf-industry-error">
                <option value="">{{ f.industryPlaceholder }}</option>
{%- for id in refer.categories %}
                <option value="{{ id }}"{% if id == industry %} selected{% endif %}>{{ r.companies.categories[loop.index0] }}</option>
{%- endfor %}
                <option value="other">{{ f.industryOther }}</option>
              </select>
              <p class="rf-error" id="rf-industry-error" hidden></p>
            </div>
            {#- The "Book a call" popup's searchable country menu
                (data-partners/call-modal.njk, download-gate-dropdown.js),
                filled by assets/refer-country.js. -#}
            <div class="rf-field">
              <label for="rf-country-toggle">{{ f.country }}</label>
              <div class="dl-dd" id="rf-country-dd">
                <button type="button" class="dl-dd-toggle" id="rf-country-toggle" aria-describedby="rf-country-error">
                  <span class="dl-dd-value is-placeholder" id="rf-country-value" data-placeholder="{{ f.countryPlaceholder }}">{{ f.countryPlaceholder }}</span>
                  <svg class="dl-dd-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
                </button>
                <div class="dl-dd-menu" id="rf-country-menu">
                  <div class="dl-dd-search"><input type="text" id="rf-country-search" autocomplete="off" placeholder="{{ f.countrySearch }}" aria-label="{{ f.countrySearch }}"></div>
                  <ul class="dl-dd-list" id="rf-country-list" aria-label="{{ f.country }}"></ul>
                  <p class="dl-dd-empty" id="rf-country-empty" hidden>{{ f.countryEmpty }}</p>
                </div>
              </div>
              <input type="hidden" id="rf-country" name="country" value="">
              <p class="rf-error" id="rf-country-error" hidden></p>
            </div>
          </div>
          <input type="hidden" name="listing" value="{{ listing }}">
        </fieldset>

        <p class="rf-consent">{{ f.consent }} <a href="/privacy/#referrals" target="_blank" rel="noopener">{{ f.privacy }}</a></p>
        {#- Left empty by people; a bot that fills every field is dropped. -#}
        <div class="rf-trap" aria-hidden="true"><label for="rf-trap">Leave this empty</label><input id="rf-trap" name="trap" type="text" tabindex="-1" autocomplete="off"></div>
        <p class="rf-error rf-send-error" id="rf-send-error" role="alert" hidden></p>
        {#- Sending is the script's job (Supabase and the sheet), so the button
            starts disabled and assets/refer-form.js enables it. Without JS
            nothing is sent anywhere, and the note says why. -#}
        <noscript><p class="rf-error">{{ f.needsJs }}</p></noscript>
        <button class="rf-submit" type="submit" data-sending="{{ f.sending }}" disabled>{{ f.submit }}</button>
      </form>

      <div class="rf-done" id="rf-done" role="status" tabindex="-1" hidden>
        <h3 class="rf-done-title">{{ f.saved.title }}</h3>
        <p>{{ f.saved.line }}</p>
        <button class="rf-again" type="button" data-again>{{ f.again }}</button>
      </div>
    </div>
<script type="application/json" id="rf-copy">{{ {
  locale: locale.code,
  store: {
    supabaseUrl: env.supabaseUrl,
    supabaseAnonKey: env.supabaseAnonKey,
    sheetEndpoint: env.dataReferralsSheetEndpoint
  },
  errors: f.errors
} | jsonScript | safe }}</script>
