{% from "enterprise/icons.njk" import arrow %}
{% from "refer/icons.njk" import glyph %}
{%- set r = t.refer -%}
{%- set amt = refer.amountText[locale.code] -%}
{# The fold: the /data-partners reel (data-partners/reel.njk) behind the
   statement and what a referral earns on the left, and the referral form
   itself on the right (stacked under the statement on phones), so referring
   a company is the first thing the page offers. Every "Refer a company" on
   the page lands on the form (#refer). #}
<header class="hero ent-hero rf-hero" id="top" data-tone="dark">
{% include "data-partners/reel.njk" %}
  <div class="rf-fold">
    <div class="rf-intro hero-load">
      <h1 class="ent-h1 rf-h1">{% for line in r.hero.h1Lines %}<span>{{ line }}</span>{% if not loop.last %} {% endif %}{% endfor %}</h1>
      <p class="ent-sub">{{ r.hero.sub | replace("{amount}", amt) }}</p>
      <div class="rf-earn" aria-labelledby="rf-earn-label">
        <p class="rf-card-label" id="rf-earn-label">{{ r.hero.card.label }}</p>
        <p class="rf-earn-amount">{{ amt }} <span>{{ r.hero.card.per }}</span></p>
        <ul class="rf-card-terms">
{%- for term in r.hero.card.terms %}
          <li>{{ glyph("check") }}<span>{{ term }}</span></li>
{%- endfor %}
        </ul>
      </div>
      <a class="rf-hero-how" href="#how">{{ r.hero.ctaHow }}{{ arrow() }}</a>
    </div>

    <div class="rf-hero-form hero-load" id="refer">
{% include "refer/form-card.njk" %}
    </div>
  </div>
</header>
