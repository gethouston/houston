{# One request's own page (/data-partners/refer/<slug>/), the card's "open"
   on the board. One layout for every request and all three locales: the
   stubs in src/data-partners/refer/ (and es/, pt/) paginate over
   `referListings.items` with the alias `item`. Text from
   `t.referListings[item.slug]` and `t.referBoard.listing`, amounts already
   formatted in `item.fmt`.

   The /enterprise look without the tone flow: a dark header band, then a
   light page with the payout card held beside the brief, then the same
   referral form as the board page, the request already chosen. #}
{% extends "base.njk" %}
{% set c = t.referListings[item.slug] %}
{% set f = item.fmt[locale.code] %}
{% set here = refer.path + item.slug + "/" %}
{% set localePath = here %}
{% set title = t.referBoard.listing.metaTitle | replace("{title}", c.title) | replace("{amount}", f.earn) %}
{% set description = c.summary %}
{% set alternates = { en: locales.en.dir + here, es: locales.es.dir + here, pt: locales.pt.dir + here } %}
{% block headScripts %}
<script>document.documentElement.className += " js";</script>
{% endblock %}
{% block stylesheets %}
<link rel="stylesheet" href="/assets/css/site-tokens.css">
<link rel="stylesheet" href="/assets/css/landing.css">
<link rel="stylesheet" href="/assets/css/landing-motion.css">
<link rel="stylesheet" href="/assets/css/download-gate.css">
<link rel="stylesheet" href="/assets/css/dl-dropdown.css">
<link rel="stylesheet" href="/assets/css/lang-switch.css">
<link rel="stylesheet" href="/assets/css/enterprise.css">
<link rel="stylesheet" href="/assets/css/refer.css">
<link rel="stylesheet" href="/assets/css/refer-form.css">
<link rel="stylesheet" href="/assets/css/refer-listing.css">
{% endblock %}
{% block body %}
{% include "refer/nav.njk" %}
<main id="main">
{% include "refer/listing-head.njk" %}
<div class="rf-lpage">
{% include "refer/listing-aside.njk" %}
{% include "refer/listing-body.njk" %}
</div>
{% include "refer/form.njk" %}
</main>
{% include "landing/footer.njk" %}
{% include "landing/download-modals.njk" %}
{% include "landing/subpage-scripts.njk" %}
{% include "enterprise/scripts.njk" %}
<script type="module" src="/assets/refer-form.js"></script>
{% endblock %}
