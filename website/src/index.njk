{% endblock %}
{% block headScripts %}
<script>
  document.documentElement.className += " js";
  // Synchronous flag (before paint) so the hero's GSAP load choreography can
  // pre-hide its pieces with no flash. Only when motion is allowed; hero-motion.js
  // clears it if the vendored libraries fail to load. Landing-only.
  try {
    if (window.matchMedia && matchMedia("(prefers-reduced-motion: no-preference)").matches) {
      document.documentElement.className += " gsap-hero";
    }
  } catch (e) {}
</script>
{% endblock %}
