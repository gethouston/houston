{
  "name": "@houston/runtime-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./object-sync": {
      "types": "./src/object-sync/index.ts",
      "import": "./src/object-sync/index.ts"
    },
    "./trim-slashes": {
      "types": "./src/trim-slashes.ts",
      "import": "./src/trim-slashes.ts"
    },
    "./sentry": {
      "types": "./src/sentry/index.ts",
      "import": "./src/sentry/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsgo -p tsconfig.json",
    "dev": "tsgo -p tsconfig.json --watch",
    "test": "vitest run --testTimeout=30000",
    "typecheck": "tsgo -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "@typescript/native-preview": "7.0.0-dev.20260607.1",
    "esbuild": "0.25.12",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "@houston/protocol": "workspace:*",
    "@sentry/core": "10.63.0"
  }
}
