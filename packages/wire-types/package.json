{
  "name": "@houston/wire-types",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "The Houston protocol v3 wire contract in TypeScript: the shared request/response shapes, the local-model-bridge port and the Retry-After parser. No I/O.",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@houston/protocol": "workspace:*"
  },
  "devDependencies": {
    "@typescript/native-preview": "7.0.0-dev.20260607.1",
    "vitest": "3.2.6"
  }
}
