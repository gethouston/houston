{
  "name": "@houston/engine-adapter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Houston engine client: every fetch, SSE stream and socket the desktop and web frontends make, binding @houston/sdk against the host.",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "vitest run ./src --testTimeout=30000",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@houston-ai/core": "workspace:*",
    "@houston/agentstore-contract": "workspace:*",
    "@houston/domain": "workspace:*",
    "@houston/protocol": "workspace:*",
    "@houston/runtime-client": "workspace:*",
    "@houston/sdk": "workspace:*",
    "@houston/wire-types": "workspace:*"
  },
  "devDependencies": {
    "@typescript/native-preview": "7.0.0-dev.20260607.1",
    "typescript": "6.0.3",
    "vite": "6.4.3",
    "vitest": "3.2.6"
  }
}
