{
  "name": "@houston-ai/engine-client",
  "version": "0.4.0",
  "description": "TypeScript client for the Houston Engine HTTP+WS protocol. Consumed by the desktop app, mobile app, and third-party integrators.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:assistant-catalog": "vitest run tests/*.spec.ts",
    "typecheck": "tsgo --noEmit && tsgo -p scripts/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@houston/agentstore-client": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "3.2.6"
  }
}
