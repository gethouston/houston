{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RoutineRuns",
  "description": "Execution history of routines.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "routine_id", "status", "session_key", "started_at"],
    "properties": {
      "id": { "type": "string" },
      "routine_id": { "type": "string" },
      "status": {
        "type": "string",
        "enum": ["running", "silent", "surfaced", "error", "cancelled"]
      },
      "session_key": { "type": "string" },
      "activity_id": { "type": "string" },
      "summary": { "type": "string" },
      "started_at": { "type": "string", "format": "date-time" },
      "completed_at": { "type": "string", "format": "date-time" },
      "paused_until": {
        "type": "string",
        "description": "Human-readable reset hint while the provider CLI is sleeping on a usage-limit window. Only meaningful when status is 'running'."
      },
      "failure": {
        "description": "Typed reason an error run never reached the agent. Account failures name the provider; 'no_model' means the routine names no model and nothing is connected to fall back on; 'usage_limit' means the account's plan used up its usage window and the routine is held until 'resets_at'.",
        "oneOf": [
          {
            "type": "object",
            "required": ["code", "provider"],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "creator_not_connected",
                  "team_not_connected",
                  "creator_needs_reconnect",
                  "team_needs_reconnect",
                  "out_of_credits",
                  "model_unavailable"
                ]
              },
              "provider": { "type": "string" }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["code"],
            "properties": { "code": { "const": "no_model" } },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["code", "provider", "model", "resets_at"],
            "properties": {
              "code": { "const": "usage_limit" },
              "provider": { "type": "string" },
              "model": { "type": ["string", "null"] },
              "resets_at": {
                "type": ["string", "null"],
                "description": "When the account's plan usage limit resets (ISO 8601); null when the provider did not say."
              }
            },
            "additionalProperties": false
          }
        ]
      },
      "delivery_failure": {
        "type": "object",
        "required": ["code"],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "pool_delivery_expired",
              "creator_no_access",
              "agent_data_needs_repair"
            ]
          }
        },
        "additionalProperties": false
      },
      "resumed": {
        "type": "boolean",
        "const": true
      },
      "manual": {
        "description": "Started by hand (Run now), as whoever pressed it, not by the schedule.",
        "type": "boolean",
        "const": true
      }
    },
    "additionalProperties": false
  }
}
